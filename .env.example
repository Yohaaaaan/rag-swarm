# RAG Swarm — environment variable template
# Copy to backend/.env and fill in real values. NEVER commit the filled file.

# --- Required ---
OPENAI_API_KEY=your_openai_key            # Embeddings (text-embedding-3-small)
MISTRAL_API_KEY=your_mistral_key          # Synthesis + HyDE (mistral-large-latest)

# --- Optional: chatbot layer (/chatbot/*) ---
OPENROUTER_API_KEY=your_openrouter_key    # Leave empty to disable the chatbot layer
OPENROUTER_MODEL=google/gemini-2.5-flash  # Chatbot model id
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- Optional: retrieval / synthesis tuning ---
USE_LANGGRAPH=false                       # true → Self-RAG / Corrective-RAG mode
HYDE_ENABLED=false                        # true → HyDE query expansion (~+11s latency)
RETRIEVAL_TOP_K=10                        # Chunks retrieved per query (5 / 10 / 15)
RETRIEVAL_SEMANTIC_WEIGHT=0.7             # Semantic vs keyword balance (0.6–0.8)
SYNTHESIS_TEMPERATURE=0.7                 # 0.3 factual … 0.7 creative

# --- Optional: storage / runtime ---
CHROMA_PERSIST_DIR=./vectorstore          # ChromaDB persistent storage path
PORT=8000                                 # Backend port
LOG_LEVEL=INFO                            # Logging verbosity
